rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Pending assessment photos — assessors upload and review these.
    match /assessments/{file} {
      allow read, write: if isSignedIn();
    }

    // Published cheesecake photos — shown publicly on the website.
    match /cheesecakes/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

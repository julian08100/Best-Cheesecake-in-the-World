rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Published rankings — read by the website and the app without
    // signing in; only admins can publish or edit.
    match /cheesecakes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allowlist — users may check their own entry; managed only
    // from the Firebase console / owner tooling.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Assessor submissions from the iOS and Android apps.
    match /assessments/{id} {
      // Every assessor sees the pending queue.
      allow read: if isSignedIn();

      // Submit only under your own uid; only admins may submit an already-approved assessment
      // (the admin fast path publishes immediately).
      allow create: if isSignedIn()
                    && request.resource.data.submittedBy == request.auth.uid
                    && (request.resource.data.status == 'pending' || isAdmin());

      // Admins manage everything (approve/status/publish). Other assessors may only add their
      // own uid to approvals or rejections (the arrayUnion vote), nothing else.
      allow update: if isAdmin() || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvals', 'rejections'])
                      && addsOnlyCaller(resource.data.get('approvals', []), request.resource.data.get('approvals', []))
                      && addsOnlyCaller(resource.data.get('rejections', []), request.resource.data.get('rejections', []))
                    );

      // Admins (reject/publish) and the submitter (delete account) may remove it.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
    }

    // A vote list may only grow by the caller's own uid; existing votes stay.
    function addsOnlyCaller(before, after) {
      return after.toSet().hasAll(before.toSet())
          && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid]);
    }

    // Website form inboxes — written by Cloud Functions (Admin SDK
    // bypasses rules), readable by admins in the app.
    match /contact_messages/{id} { allow read, write: if isAdmin(); }
    match /assessment_requests/{id} { allow read, write: if isAdmin(); }
    match /cheesecake_submissions/{id} { allow read, write: if isAdmin(); }
  }
}

